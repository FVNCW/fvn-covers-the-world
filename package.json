{
    "name": "fvn-covers-the-world",
    "private": true,
    "type": "module",
    "module": "src/index.ts",
    "scripts": {
        "dev": "NODE_ENV=development bun run .",
        "start": "NODE_ENV=production bun run .",
        "lint:style": "oxlint .",
        "lint:format": "oxfmt .",
        "lint:type": "tsc --noEmit",
        "lint": "run-p lint:style lint:format lint:type",
        "studio": "better-auth-studio start --config src/engine/lib/auth.ts",
        "generate:openapi": "openapi --input FCTW.openapi.json --output src/engine/schema/api",
        "generate:database": "drizzle-kit generate",
        "generate": "run-p generate:openapi generate:database",
        "push": "drizzle-kit push"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.2",
        "better-auth": "^1.7.1",
        "commander": "^15.0.0",
        "drizzle-orm": "^0.45.2",
        "elysia": "^1.4.29",
        "postgres": "^3.4.9"
    },
    "devDependencies": {
        "@better-auth/cli": "^1.4.21",
        "@types/bun": "latest",
        "@types/node": "^26.3.0",
        "auth": "^1.7.1",
        "better-auth-studio": "^1.1.5",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.10",
        "npm-run-all": "^4.1.5",
        "npx": "^10.2.2",
        "openapi-typescript": "^7.13.0",
        "openapi-typescript-codegen": "^0.31.0",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0"
    },
    "peerDependencies": {
        "typescript": "5.9.3"
    }
}
