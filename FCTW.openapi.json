    "/api/character/create": {
      "post": {
        "summary": "创建角色",
        "deprecated": false,
        "description": "",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "标签文本"
                    },
                    "description": "标签"
                  },
                  "displayName": {
                    "type": "string",
                    "description": "中文名"
                  },
                  "isDied": {
                    "type": "boolean",
                    "description": "是否已故"
                  },
                  "isFemale": {
                    "type": "boolean",
                    "description": "女的来了"
                  },
                  "information": {
                    "type": "object",
                    "properties": {
                      "background": {
                        "type": "string",
                        "description": "背景故事"
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "作品名，为空则直接隶属于因特网"
                        },
                        "description": "来源作品"
                      },
                      "personality": {
                        "type": "string",
                        "description": "人格"
                      },
                      "description": {
                        "type": "string",
                        "description": "综合介绍"
                      }
                    },
                    "description": "信息聚合",
                    "required": [
                      "background",
                      "sources",
                      "personality",
                      "description"
                    ]
                  },
                  "specy": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "description": "指向父级物种ID"
                        },
                        "description": "混血种"
                      },
                      {
                        "type": "number",
                        "description": "纯血种"
                      }
                    ],
                    "description": "物种"
                  },
                  "height": {
                    "type": "number",
                    "description": "身高"
                  },
                  "length": {
                    "type": "number",
                    "description": "这是一个神秘字段"
                  },
                  "color": {
                    "type": "object",
                    "properties": {
                      "fur": {
                        "$ref": "#/components/schemas/ComposedColor",
                        "description": "毛发颜色"
                      },
                      "eye": {
                        "$ref": "#/components/schemas/ComposedColor",
                        "description": "瞳孔颜色"
                      },
                      "other": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": {
                          "$ref": "#/components/schemas/ComposedColor"
                        },
                        "description": "其他自定义部位的颜色"
                      }
                    },
                    "required": [
                      "fur",
                      "eye",
                      "other"
                    ],
                    "description": "颜色字典"
                  },
                  "relationShips": {
                    "type": "object",
                    "properties": {
                      "parents": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "description": "家人"
                      },
                      "friends": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "description": "朋友"
                      },
                      "children": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "description": "孩子"
                      },
                      "other": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "description": "其他关系"
                      }
                    },
                    "description": "关系节点",
                    "required": [
                      "parents",
                      "friends",
                      "children",
                      "other"
                    ]
                  }
                },
                "required": [
                  "tags",
                  "displayName",
                  "isDied",
                  "isFemale",
                  "information",
                  "specy",
                  "height",
                  "length",
                  "color",
                  "relationShips"
                ]
              },
              "example": {
                "displayName": "哀治文",
                "personality": "velit pariatur Excepteur"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Character"
